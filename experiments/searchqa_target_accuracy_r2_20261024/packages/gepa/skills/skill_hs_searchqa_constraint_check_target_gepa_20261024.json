        "type": "string"
      },
      "context": {
        "type": "string"
      },
      "answer": {
        "type": "string",
        "minLength": 1
      },
      "quotes": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "required": [
      "question",
      "context",
      "answer"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
